{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "三线首城开发运行事件，不代表完整M2验收",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "packageId",
    "scope",
    "status",
    "cityId",
    "routes"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "packageId": {
      "const": "campaign.first-city-development.v1"
    },
    "scope": {
      "const": "first-city-development"
    },
    "status": {
      "const": "development"
    },
    "cityId": {
      "const": "city.liuping"
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "consequence"
      ],
      "properties": {
        "id": {
          "enum": [
            "a",
            "b"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "consequence": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "outlineBeatId",
        "id",
        "title",
        "text",
        "choices"
      ],
      "properties": {
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "outlineBeatId": {
          "type": "string",
          "pattern": "^story\\.(damage|control|tank)\\.0[1-3]$"
        },
        "id": {
          "type": "string",
          "pattern": "^first-city\\.(damage|control|tank)\\.0[1-3]$"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "epilogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openingChoiceId",
        "text"
      ],
      "properties": {
        "openingChoiceId": {
          "enum": [
            "a",
            "b"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "events",
        "epilogues"
      ],
      "properties": {
        "origin": {
          "enum": [
            "damage",
            "control",
            "tank"
          ]
        },
        "events": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "epilogues": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/epilogue"
          }
        }
      }
    }
  }
}
